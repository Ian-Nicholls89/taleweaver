# ---- Required ----

# Long random secret used to encrypt the AI provider keys stored in the database.
# Generate one with:  openssl rand -base64 48
# Keep it safe: if it changes, saved API keys can no longer be read (just re-enter them).
APP_SECRET=

# The first admin account. Only used when the database has no users yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Your address ----

# The public address players use (your subdomain). Used for invite links and to
# turn on secure cookies when it starts with https://
PUBLIC_URL=https://dnd.example.com

# Set to true when running behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel)
# so login rate limits see each visitor's real IP address.
TRUST_PROXY=true

# ---- Networking (docker compose) ----

# Port on the HOST that your reverse proxy points at (e.g. proxy_pass http://127.0.0.1:3333).
# The app always listens on port 3000 *inside* the container regardless of this
# value — docker-compose.yml maps this host port to that fixed container port.
PORT=3000
# 127.0.0.1 = only this machine can reach it (recommended when the proxy is on the same host).
# 0.0.0.0   = reachable from your LAN (needed if the proxy runs on another machine).
BIND_ADDRESS=127.0.0.1

# ---- Development only ----

# Adds a scripted "mock" Dungeon Master and placeholder images for testing without API keys.
# TALEWEAVER_ENABLE_MOCK=1
