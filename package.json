{
  "name": "taleweaver",
  "version": "0.1.0",
  "description": "Self-hosted AI Dungeon Master for single-player D&D one-shots",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "create-admin": "tsx scripts/create-admin.ts",
    "build:cli": "esbuild scripts/create-admin.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/create-admin.cjs --external:better-sqlite3 --external:@node-rs/argon2 --log-level=warning"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.63",
    "@ai-sdk/cerebras": "^3.0.55",
    "@ai-sdk/deepseek": "^3.0.52",
    "@ai-sdk/google": "^4.0.80",
    "@ai-sdk/groq": "^4.0.48",
    "@ai-sdk/mistral": "^4.0.50",
    "@ai-sdk/openai": "^4.0.75",
    "@ai-sdk/perplexity": "^4.0.50",
    "@ai-sdk/xai": "^5.0.8",
    "@node-rs/argon2": "^2.2.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.114",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "gray-matter": "^4.0.3",
    "howler": "^2.2.4",
    "next": "^16.3.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
